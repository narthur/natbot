{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natbot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "ask.nathanarthur.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ChatAgent", "class_name": "ChatAgent" },
      { "name": "Budget", "class_name": "Budget" }
    ]
  },
  "workflows": [{ "name": "natbot-handoff", "binding": "HANDOFF_WORKFLOW", "class_name": "HandoffWorkflow" }],
  // Secrets: TURNSTILE_SECRET_KEY, MAILGUN_API_KEY (domain-scoped to mail.nathanarthur.com, ADR 0004).
  // SENTRY_DSN (natbot-worker) only lets you send events, so it isn't a secret.
  "vars": {
    "HANDOFF_TO": "nathan@nathanarthur.com",
    "SENTRY_DSN": "https://28b60ace403cfd26dd17ecba345c43b3@o4511632382558208.ingest.us.sentry.io/4512148291846144"
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent", "Budget"] }],
  // Limits are per Cloudflare location, so they bound bursts rather than exact totals; Budget is the hard daily cap.
  "ratelimits": [
    { "name": "CONNECT_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
    { "name": "MESSAGE_LIMITER", "namespace_id": "4202", "simple": { "limit": 6, "period": 60 } }
  ]
}
