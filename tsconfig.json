{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Worker runtime types come from `wrangler types` (src/worker/env.d.ts).
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "*.test.ts"]
}
